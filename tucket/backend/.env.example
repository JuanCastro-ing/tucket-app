# Copia este archivo como backend/.env y completa los valores.
# backend/.env NO se sube al repositorio: contiene credenciales.

PORT=8000

# ---------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------
# NEON (lo que usa el proyecto). La cadena se copia de la consola de Neon:
#   Project → Connect → Connection string → "Pooled connection"
# Debe terminar en ?sslmode=require
DATABASE_URL=

# PostgreSQL local (alternativa para trabajar sin internet):
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/tucket

# TLS: se activa solo cuando hace falta (Neon o sslmode=require).
# Solo pon DB_SSL a mano si necesitas forzarlo.
# DB_SSL=true
# DB_SSL_INSECURE=true   # último recurso si el certificado no valida

# ---------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
