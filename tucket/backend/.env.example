# Copia este archivo como backend/.env y completa los valores.
# backend/.env NO se sube al repositorio: contiene credenciales.

PORT=8000

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# NEON (lo que usa el proyecto). La cadena se copia de la consola de Neon:
#   Project → Connect → Connection string → "Pooled connection"
# Debe terminar en ?sslmode=require
DATABASE_URL=

# PostgreSQL local (alternativa para trabajar sin internet):
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/tucket

# TLS: se activa solo cuando hace falta (Neon o sslmode=require).
# Solo pon DB_SSL a mano si necesitas forzarlo.
# DB_SSL=true
# DB_SSL_INSECURE=true   # último recurso si el certificado no valida

# ------------------------------------------------------------
# Sesión
# ------------------------------------------------------------
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ------------------------------------------------------------
# Imágenes de los eventos (afiches y banners)
# ------------------------------------------------------------
# Si estas tres variables están vacías, las imágenes se guardan como
# archivos en backend/uploads/events/. Eso basta para trabajar en tu
# computador y no requiere cuenta en ningún lado.
#
# En el servidor publicado hay que llenarlas. Los servicios de despliegue
# reconstruyen el servidor en cada publicación con un disco nuevo, así
# que los archivos subidos por los agentes se perderían. Con estas
# variables, las imágenes se suben a Cloudinary y sobreviven a todo.
#
# Se sacan de https://cloudinary.com → Dashboard. El plan gratuito
# alcanza de sobra para este proyecto.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
