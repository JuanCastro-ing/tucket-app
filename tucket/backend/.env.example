# Copia este archivo como backend/.env y completa los valores.
# backend/.env NO se sube al repositorio: contiene credenciales.

PORT=8000

# ---------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------
# NEON (lo que usa el proyecto). La cadena se copia de la consola de Neon:
#   Project → Connect → Connection string → "Pooled connection"
# Debe terminar en ?sslmode=require
